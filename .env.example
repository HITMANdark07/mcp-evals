# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# `.env` is git-ignored. Never put real keys in this example file.

# OpenRouter API key (https://openrouter.ai/settings/keys).
# Tip: set a monthly credit limit on the key as a safety net.
OPENROUTER_API_KEY=

# Optional, for --provider openai-compatible (local servers such as Ollama, LM Studio, vLLM, llama.cpp).
# Base URL used when --base-url is not given, e.g. http://localhost:11434/v1 for Ollama.
OPENAI_COMPATIBLE_BASE_URL=
# Only if your server requires one; sent as a Bearer token. Local servers usually need none.
OPENAI_COMPATIBLE_API_KEY=
